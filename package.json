{
  "name": "memequiz",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "pnpm --filter @memequiz/shared build",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "content:optimize": "node scripts/optimize-memes.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @memequiz/api db:migrate",
    "db:deploy": "pnpm --filter @memequiz/api db:deploy"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
