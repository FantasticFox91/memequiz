# Скопируйте в .env и заполните. .env не коммитится.

# --- Общие ---
NODE_ENV=development

# --- Postgres ---
# Используются контейнером postgres (dev и prod compose)
POSTGRES_USER=memequiz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=memequiz

# Строка подключения для api, запущенного локально (pnpm dev).
# В Docker-compose api получает свою строку с хостом postgres.
DATABASE_URL=postgresql://memequiz:change-me@localhost:5432/memequiz

# --- API ---
PORT=3000
# вход в админку /admin (проверка текстовых ответов). Пароль от 12 символов: openssl rand -base64 18.
# Не заданы — админка выключена
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Общий лидерборд двух серверов ---
# SERVER_ID: метка этого сервера (main, ru); у двух серверов должны быть разные.
# PEER_URL: адрес второго сервера. Пусто — лидерборд только этого сервера
SERVER_ID=main
PEER_URL=

# --- Бэкапы (prod) ---
# Push-URL монитора Uptime Kuma: scripts/backup.sh дёргает его после удачного дампа. Пусто — без отметки
BACKUP_PUSH_URL=

# --- Caddy (prod) ---
SITE_ADDRESS=memequiz.94-141-161-179.sslip.io

# --- Telegram (этап 7) ---
TELEGRAM_BOT_TOKEN=
# сколько секунд initData Mini App считается свежим (по умолчанию сутки)
TG_INIT_DATA_TTL=86400
# бот (/start с кнопкой Mini App, long polling). В prod compose включён по умолчанию,
# WEB_APP_URL там собирается из SITE_ADDRESS. Локально не включайте с prod-токеном:
# Telegram отдаёт обновления только одному получателю, и бот на сервере замолчит
BOT_ENABLED=false
WEB_APP_URL=
