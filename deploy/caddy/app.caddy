# Общие маршруты для prod и локального Caddyfile
(app) {
	encode zstd gzip

	# X-Frame-Options не ставим: Telegram Web открывает Mini App в iframe
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# файлы с хэшем в имени кэшируем навсегда, остальное (index.html и т.п.) всегда перепроверяем
		@hashed path /_nuxt/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# мемы и песни без хэша в имени: час, чтобы замена файла под тем же именем доезжала быстро
		@media path /memes/* /audio/*
		header @media Cache-Control "public, max-age=3600"
		@other not path /_nuxt/* /memes/* /audio/*
		header @other Cache-Control "no-cache"

		# SPA: неизвестные пути отдаём в 200.html, роутинг делает Nuxt
		try_files {path} {path}/index.html /200.html
		file_server
	}
}
