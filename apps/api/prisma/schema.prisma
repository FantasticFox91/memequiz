generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ParticipantSource {
  web
  tg
}

/// Первый (и единственный засчитанный) результат участника в викторине.
/// externalId: web — id из куки mq_pid, tg — Telegram user.id
model Result {
  id          Int               @id @default(autoincrement())
  source      ParticipantSource
  externalId  String            @map("external_id")
  /// id викторины = имя файла apps/api/content/quizzes/<id>.json
  quizId      String            @map("quiz_id")
  nickname    String
  /// nicknameKey() из shared: для проверки, что ник на сайте не занят (lower() в Postgres зависит от локали)
  nicknameKey String            @map("nickname_key")
  score       Int
  total       Int
  /// Время прохождения по часам сервера: от первого POST /quiz/start до submit. null — старт не записан
  durationMs  Int?              @map("duration_ms")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Не используется: выгрузка в Google Sheets (этап 5) отменена. Колонка оставлена, чтобы не делать миграцию
  syncedAt    DateTime?         @map("synced_at") @db.Timestamptz(3)
  textAnswers TextAnswer[]

  @@unique([source, externalId, quizId])
  @@index([quizId, score(sort: Desc), durationMs, createdAt])
  @@index([nicknameKey])
  @@map("results")
}

/// Текстовые ответы засчитанной попытки для ручной проверки в админке (/admin).
/// points входит в Result.score: при новой оценке score меняется на разницу.
/// Пока у результата есть непроверенные ответы, его баллы скрыты и в лидерборде его нет
model TextAnswer {
  id         Int     @id @default(autoincrement())
  resultId   Int     @map("result_id")
  result     Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId String  @map("question_id")
  text       String
  /// 0..2; до проверки — предложение автопроверки по acceptedAnswers
  points     Int
  /// true — оценку поставил админ
  reviewed   Boolean @default(false)

  @@unique([resultId, questionId])
  @@index([reviewed, questionId])
  @@map("text_answers")
}

/// Когда участник впервые открыл викторину. Пишется один раз: перезапуск не сбрасывает таймер
model QuizStart {
  source     ParticipantSource
  externalId String            @map("external_id")
  quizId     String            @map("quiz_id")
  startedAt  DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)

  @@id([source, externalId, quizId])
  @@map("quiz_starts")
}

/// Карта нефти из конструктора (/map). id — он же код в ссылке /map?id=.
/// Раскладку меняет только владелец (тот же source + externalId, что у результатов викторины),
/// держателей точек отмечает любой со ссылкой
model OilMap {
  id           String            @id
  ownerSource  ParticipantSource @map("owner_source")
  ownerId      String            @map("owner_id")
  name         String
  /// OilMapLayout из shared: точки, связи, союзы, aspect
  layout       Json
  /// растёт при каждом сохранении раскладки: по ней ловим правку устаревшей версии
  version      Int               @default(1)
  /// фон-скриншот; читается только отдельным эндпоинтом, в остальных запросах omit
  image        Bytes?
  imageType    String?           @map("image_type")
  /// 0 — фона нет
  imageVersion Int               @default(0) @map("image_version")
  /// сколько дней на карте; держатели у каждого дня свои
  days         Int               @default(1)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  holders      OilMapHolder[]

  @@index([ownerSource, ownerId])
  @@map("oil_maps")
}

/// Кто сидит на точке. Отдельная строка на точку: одновременные отметки разных точек
/// не перетирают друг друга. Свободная точка — строки нет
model OilMapHolder {
  mapId      String   @map("map_id")
  map        OilMap   @relation(fields: [mapId], references: [id], onDelete: Cascade)
  /// с 1
  day        Int      @default(1)
  pointId    String   @map("point_id")
  allianceId String   @map("alliance_id")
  /// ник того, кто отметил последним
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([mapId, day, pointId])
  @@map("oil_map_holders")
}
