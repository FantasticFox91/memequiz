generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ParticipantSource {
  web
  tg
}

/// Первый (и единственный засчитанный) результат участника
model Result {
  id         Int               @id @default(autoincrement())
  source     ParticipantSource
  externalId String            @map("external_id")
  nickname   String
  score      Int
  total      Int
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Не используется: выгрузка в Google Sheets (этап 5) отменена. Колонка оставлена, чтобы не делать миграцию
  syncedAt   DateTime?         @map("synced_at") @db.Timestamptz(3)

  @@unique([source, externalId])
  @@index([score(sort: Desc), createdAt])
  @@map("results")
}
